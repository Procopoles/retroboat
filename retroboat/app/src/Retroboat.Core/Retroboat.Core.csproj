<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Retroboat</RootNamespace>
    <AssemblyName>Retroboat.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Retroboat.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- JavaScriptSerializer, para as respostas JSON do Wikidata e da Wikipédia (WikidataInfo). -->
    <Reference Include="System.Web.Extensions" />
    <!-- ZipArchive, para ler o pacote do ES do repositório do RetroBat na busca de chaves (RB-037). Vem com o .NET 4.8. -->
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <!-- Status do Retroboat para os temas (ThemeOverlays). Cópias dos clones dos temas; o teste
         Bundled_overlays_match_the_theme_clones avisa se ficarem diferentes. -->
    <EmbeddedResource Include="Themes\Overlays\es-theme-carbon\status.xml" LogicalName="Retroboat.Themes.es-theme-carbon.status.xml" />
    <EmbeddedResource Include="Themes\Overlays\es-theme-PlayStation-X\status.xml" LogicalName="Retroboat.Themes.es-theme-PlayStation-X.status.xml" />
    <EmbeddedResource Include="Themes\Overlays\es-theme-PlayStation-X\atraso-do-video.xml" LogicalName="Retroboat.Themes.es-theme-PlayStation-X.atraso-do-video.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Emulador do ES → pacote do repositório do RetroBat (EmulatorCatalog, RB-033). -->
    <EmbeddedResource Include="Emulators\EmulatorCatalog.xml" LogicalName="Retroboat.Emulators.EmulatorCatalog.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sistema do ES → plataforma em cada fonte do PERSONALIZADO (MediaSystems, RB-038). -->
    <EmbeddedResource Include="Media\Sources\MediaSystems.xml" LogicalName="Retroboat.Media.Sources.MediaSystems.xml" />
  </ItemGroup>

</Project>
