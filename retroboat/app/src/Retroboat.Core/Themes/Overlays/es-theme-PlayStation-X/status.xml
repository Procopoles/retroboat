      <maxSize>0.2 0.25</maxSize>
    </video>
    <image name="rbActionBar, rbPlayButton, rbDownloadButton, rbDownloadingButton, rbUnavailableButton" extra="true">
      <visible>false</visible>
    </image>
    <text name="rbPlayLabel, rbDownloadLabel, rbDownloadingLabel, rbUnavailableLabel, rbPlayCaption, rbDownloadCaption, rbDownloadingCaption, rbUnavailableCaption, rbPlayValue, rbDownloadValue, rbDownloadingValue, rbUnavailableValue" extra="true">
      <visible>false</visible>
    </text>
  </customView>

  <!-- Estados do botão (cor, rótulo, legenda e valor), iguais nas três visões que têm o botão.
       Com vírgula e sem inherits, o ES aplica o bloco só às visões listadas que já existem, sem
       repassar às que herdam delas (test-medias continua sem o botão). -->
  <customView name="detailed, ps4Style, single">
    <!-- Instalado: JOGAR -->
    <image name="rbPlayButton" extra="true">
      <visible>${rbGame} &amp;&amp; !${rbMarker}</visible>
      <color>50C82F</color>
      <colorEnd>18B14E</colorEnd>
      <gradientType>horizontal</gradientType>
    </image>
    <text name="rbPlayLabel" extra="true">
      <visible>${rbGame} &amp;&amp; !${rbMarker}</visible>
      <text>&#xF04B;  JOGAR</text>
    </text>
    <text name="rbPlayCaption" extra="true">
