      <color>E5484D</color>
    </text>
    <text name="rbUnavailableValue" extra="true">
      <visible>${rbGame} &amp;&amp; ${rbMarker} &amp;&amp; ${rbCorrupt}</visible>
      <text>Troque o arquivo no Drive</text>
    </text>
  </customView>

  <!-- Drive fechado (o lançador não achou o Google Drive): BAIXAR continua valendo, porque o Retroboat
       oferece abrir o Drive ao apertar. Não é defeito, então nada de vermelho: só um aviso em amarelo. -->
  <customView name="detailed, ps4Style, single" if='!exists(${themePath} + "/../../../../retroboat/estado/nuvem-conectada")'>
    <text name="rbDownloadCaption" extra="true">
      <text>NA NUVEM · DRIVE FECHADO</text>
      <color>FFC82C</color>
    </text>
    <text name="rbDownloadValue" extra="true">
      <text>Abre o Google Drive e baixa</text>
    </text>
    <text name="rbDownloadingValue" extra="true">
      <text>Continua quando o Google Drive voltar</text>
    </text>
  </customView>

  <!-- Só com o ES do Retroboat (RB-010), que cria retroboat\estado\es-nativo ao abrir: o andamento ao vivo no
       lugar do aviso, e a região do cabeçalho é do próprio ES. Vem depois do "Drive fechado" para valer sobre ele. -->
  <customView name="detailed, ps4Style, single" if='exists(${themePath} + "/../../../../retroboat/estado/es-nativo")'>
    <text name="rbDownloadingValue" extra="true">
      <text>{game:downloadProgress}</text>
    </text>
  </customView>
</theme>
