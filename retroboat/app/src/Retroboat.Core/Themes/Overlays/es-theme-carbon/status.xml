    <!-- Baixando em segundo plano: BAIXANDO -->
    <image name="rbDownloadingButton" extra="true">
      <visible>${rbGame} &amp;&amp; ${rbMarker} &amp;&amp; !${rbCorrupt} &amp;&amp; ${rbDownloading}</visible>
      <path>./../art/white.png</path>
      <color>2D323D</color>
      <roundCorners>3</roundCorners>
      <pos>0.553 0.68</pos>
      <origin>0 0.5</origin>
      <size>0.115 0.048</size>
      <zIndex>36</zIndex>
    </image>
    <text name="rbDownloadingLabel" extra="true">
      <visible>${rbGame} &amp;&amp; ${rbMarker} &amp;&amp; !${rbCorrupt} &amp;&amp; ${rbDownloading}</visible>
      <text>&#xF019;  BAIXANDO</text>
      <pos>0.553 0.68</pos>
      <origin>0 0.5</origin>
      <size>0.115 0.048</size>
      <alignment>center</alignment>
      <fontPath>./../art/fonts/Cabin-Bold.ttf</fontPath>
      <fontSize>0.021</fontSize>
      <color>1A9FFF</color>
      <zIndex>37</zIndex>
    </text>
    <text name="rbDownloadingCaption" extra="true">
      <visible>${rbGame} &amp;&amp; ${rbMarker} &amp;&amp; !${rbCorrupt} &amp;&amp; ${rbDownloading}</visible>
      <text>BAIXANDO</text>
      <pos>0.68 0.663</pos>
      <origin>0 0.5</origin>
      <size>0.25 0.03</size>
      <fontPath>./../art/fonts/Cabin-Bold.ttf</fontPath>
      <fontSize>0.017</fontSize>
      <color>1A9FFF</color>
      <zIndex>37</zIndex>
    </text>
    <text name="rbDownloadingValue" extra="true">
      <visible>${rbGame} &amp;&amp; ${rbMarker} &amp;&amp; !${rbCorrupt} &amp;&amp; ${rbDownloading}</visible>
      <text>O andamento aparece no topo da tela</text>
      <pos>0.68 0.694</pos>
      <origin>0 0.5</origin>
      <size>0.25 0.035</size>
      <fontPath>./../art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.02</fontSize>
      <color>DCDEDF</color>
      <zIndex>37</zIndex>
    </text>

    <!-- Corrompido na nuvem: INDISPONÍVEL -->
    <image name="rbUnavailableButton" extra="true">
      <visible>${rbGame} &amp;&amp; ${rbMarker} &amp;&amp; ${rbCorrupt}</visible>
      <path>./../art/white.png</path>
      <color>2E3136</color>
      <roundCorners>3</roundCorners>
      <pos>0.553 0.68</pos>
      <origin>0 0.5</origin>
      <size>0.115 0.048</size>
