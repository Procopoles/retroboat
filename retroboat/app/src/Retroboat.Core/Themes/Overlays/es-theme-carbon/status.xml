  <!-- Drive fechado (o lançador não achou o Google Drive): BAIXAR continua valendo, porque o Retroboat
       oferece abrir o Drive ao apertar. Não é defeito, então nada de vermelho: só um aviso em amarelo. -->
  <view name="detailed" if='!exists(${themePath} + "/../../../../retroboat/estado/nuvem-conectada")'>
    <text name="rbDownloadCaption" extra="true">
      <text>NA NUVEM · DRIVE FECHADO</text>
      <color>FFC82C</color>
    </text>
    <text name="rbDownloadValue" extra="true">
      <text>Abre o Google Drive e baixa</text>
    </text>
    <text name="rbDownloadingValue" extra="true">
      <text>Continua quando o Google Drive voltar</text>
    </text>
  </view>

  <!-- Visões em grade e carrossel: ícone de status na faixa de informações do jogo. -->
  <view name="grid,gamecarousel">
    <text name="rbBadgeCloud" extra="true" ifSubset="gameBar:yes">
      <visible>${rbGame} &amp;&amp; ${rbMarker} &amp;&amp; !${rbCorrupt} &amp;&amp; !${rbDownloading}</visible>
      <text>&#xF0ED;</text>
      <pos>0.976 0.635</pos>
      <origin>0.5 0.5</origin>
      <size>0.04 0.04</size>
      <alignment>center</alignment>
      <fontSize>0.03</fontSize>
      <color>1A9FFF</color>
      <zIndex>15</zIndex>
    </text>
    <text name="rbBadgeDownloading" extra="true" ifSubset="gameBar:yes">
      <visible>${rbGame} &amp;&amp; ${rbMarker} &amp;&amp; !${rbCorrupt} &amp;&amp; ${rbDownloading}</visible>
      <text>&#xF019;</text>
      <pos>0.976 0.635</pos>
      <origin>0.5 0.5</origin>
      <size>0.04 0.04</size>
      <alignment>center</alignment>
      <fontSize>0.03</fontSize>
      <color>1A9FFF</color>
      <zIndex>15</zIndex>
    </text>
    <text name="rbBadgeInstalled" extra="true" ifSubset="gameBar:yes">
      <visible>${rbGame} &amp;&amp; !${rbMarker}</visible>
      <text>&#xF058;</text>
      <pos>0.976 0.635</pos>
      <origin>0.5 0.5</origin>
      <size>0.04 0.04</size>
      <alignment>center</alignment>
      <fontSize>0.03</fontSize>
      <color>59BF40</color>
      <zIndex>15</zIndex>
