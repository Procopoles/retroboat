      <pos>0.553 0.68</pos>
      <origin>0 0.5</origin>
      <size>0.115 0.048</size>
      <alignment>center</alignment>
      <fontPath>./../art/fonts/Cabin-Bold.ttf</fontPath>
      <fontSize>0.02</fontSize>
