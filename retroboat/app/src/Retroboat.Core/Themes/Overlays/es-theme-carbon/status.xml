    <!-- Na nuvem: BAIXAR -->
    <image name="rbDownloadButton" extra="true">
      <visible>${rbGame} &amp;&amp; ${rbMarker} &amp;&amp; !${rbCorrupt} &amp;&amp; !${rbDownloading}</visible>
      <path>./../art/white.png</path>
      <color>3A9BED</color>
      <colorEnd>235DCE</colorEnd>
      <gradientType>horizontal</gradientType>
      <roundCorners>3</roundCorners>
      <pos>0.553 0.68</pos>
      <origin>0 0.5</origin>
      <size>0.115 0.048</size>
      <zIndex>36</zIndex>
    </image>
    <text name="rbDownloadLabel" extra="true">
      <visible>${rbGame} &amp;&amp; ${rbMarker} &amp;&amp; !${rbCorrupt} &amp;&amp; !${rbDownloading}</visible>
      <text>&#xF019;  BAIXAR</text>
      <pos>0.553 0.68</pos>
      <origin>0 0.5</origin>
      <size>0.115 0.048</size>
      <alignment>center</alignment>
      <fontPath>./../art/fonts/Cabin-Bold.ttf</fontPath>
      <fontSize>0.024</fontSize>
      <color>FFFFFF</color>
      <zIndex>37</zIndex>
    </text>
    <text name="rbDownloadCaption" extra="true">
      <visible>${rbGame} &amp;&amp; ${rbMarker} &amp;&amp; !${rbCorrupt} &amp;&amp; !${rbDownloading}</visible>
      <text>NA NUVEM</text>
      <pos>0.68 0.663</pos>
      <origin>0 0.5</origin>
      <size>0.25 0.03</size>
      <fontPath>./../art/fonts/Cabin-Bold.ttf</fontPath>
      <fontSize>0.017</fontSize>
      <color>8B929A</color>
      <zIndex>37</zIndex>
    </text>
    <text name="rbDownloadValue" extra="true">
      <visible>${rbGame} &amp;&amp; ${rbMarker} &amp;&amp; !${rbCorrupt} &amp;&amp; !${rbDownloading}</visible>
      <text>Baixa em segundo plano</text>
      <pos>0.68 0.694</pos>
