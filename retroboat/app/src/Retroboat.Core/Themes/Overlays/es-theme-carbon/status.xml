      <zIndex>37</zIndex>
    </text>
    <text name="rbUnavailableCaption" extra="true">
      <visible>${rbGame} &amp;&amp; ${rbMarker} &amp;&amp; ${rbCorrupt}</visible>
      <text>CORROMPIDO NA NUVEM</text>
      <pos>0.68 0.663</pos>
      <origin>0 0.5</origin>
      <size>0.25 0.03</size>
      <fontPath>./../art/fonts/Cabin-Bold.ttf</fontPath>
      <fontSize>0.017</fontSize>
      <color>E5484D</color>
      <zIndex>37</zIndex>
    </text>
    <text name="rbUnavailableValue" extra="true">
      <visible>${rbGame} &amp;&amp; ${rbMarker} &amp;&amp; ${rbCorrupt}</visible>
      <text>Troque o arquivo no Drive</text>
      <pos>0.68 0.694</pos>
      <origin>0 0.5</origin>
      <size>0.25 0.035</size>
      <fontPath>./../art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.02</fontSize>
      <color>DCDEDF</color>
