      <text>&#xF071;</text>
      <pos>0.976 0.635</pos>
      <origin>0.5 0.5</origin>
      <size>0.04 0.04</size>
      <alignment>center</alignment>
      <fontSize>0.03</fontSize>
      <color>E5484D</color>
      <zIndex>15</zIndex>
    </text>
  </view>
  <view name="grid,gamecarousel" if='!exists(${themePath} + "/../../../../retroboat/estado/nuvem-conectada")'>
    <text name="rbBadgeCloud" extra="true" ifSubset="gameBar:yes">
      <color>67707B</color>
    </text>
  </view>
</theme>
